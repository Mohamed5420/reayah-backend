{
  "name": "reayah-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Reayah backend — Express + TypeScript + MongoDB + Socket.IO + BullMQ",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"tests/**/*.ts\" \"*.{mts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" \"tests/**/*.ts\" \"*.{mts,mjs}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "tsx src/docs/export-openapi.ts",
    "admin:create": "tsx src/scripts/create-admin.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@bull-board/api": "^6.5.0",
    "@bull-board/express": "^6.5.0",
    "@sentry/node": "^11.4.0",
    "bullmq": "^5.30.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^13.0.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "typedi": "^0.10.0",
    "winston": "^3.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis-mock": "^8.2.8",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "ioredis-mock": "^8.13.1",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.3.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
