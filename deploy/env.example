# Server environment for deploy/docker-compose.yml — copy to deploy/.env on the server (never commit it).
# One file per environment: staging and production must not share any secret.
# Generate secrets with:  openssl rand -base64 48   (FIELD_ENCRYPTION_KEY: openssl rand -base64 32)

# ── Deployment ───────────────────────────────────────────────────────────────
# staging: OTP codes appear in the server log (SMS_DRIVER=log), Swagger at /docs, `npm run seed:staging` allowed.
# production: needs a real SMS_DRIVER; no /docs.
NODE_ENV=staging
API_DOMAIN=api-staging.example.com          # DNS A record → this server; Caddy gets the HTTPS certificate
IMAGE=ghcr.io/OWNER/reaya-api               # set by CI
IMAGE_TAG=latest                            # set by CI on each deploy
CORS_ORIGINS=https://admin.example.com      # admin panel origin(s), comma-separated; mobile apps don't need CORS

# ── Secrets (required) ───────────────────────────────────────────────────────
JWT_SECRET=
# 32 random bytes, base64. Losing it makes encrypted medical/identity data unreadable (backups too).
# Store a copy in the password manager / secret manager, separately from database backups.
FIELD_ENCRYPTION_KEY=

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Self-hosted profile (MongoDB on this server):
MONGO_ROOT_USER=reaya
MONGO_ROOT_PASSWORD=
MONGO_REPLICA_KEY=                          # openssl rand -base64 48
MONGO_URI=mongodb://reaya:CHANGE_ME@mongo:27017/reaya?authSource=admin&replicaSet=rs0
# Managed MongoDB instead: its connection string (must be a replica set — transactions are required).

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── File storage (private, S3-compatible) ────────────────────────────────────
# Self-hosted MinIO: keep the endpoint below. The host's object storage: its endpoint, keys and bucket.
S3_BUCKET=reaya-private
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=reaya
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Outside services ─────────────────────────────────────────────────────────
SMS_DRIVER=log                              # `log` refuses to run in production — set the real provider once chosen
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase.json   # put the file in deploy/secrets/ (optional)
SENTRY_DSN=                                 # optional error tracking

# ── Payments (card / mobile wallet) ────────────────────────────────────────
# paymob in staging (sandbox keys) and production (live keys). The webhook URL to set in Paymob:
#   https://<API_DOMAIN>/api/v1/webhooks/payments/paymob
PAYMENT_GATEWAY=paymob
PUBLIC_API_URL=https://api-staging.example.com
APP_PAYMENT_RETURN_URL=reaya://payment-result
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=

# ── Limits & tools ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=30
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=                        # set to enable /admin/queues (job dashboard)

# Referral share links (GET /me/referral)
REFERRAL_LINK_BASE=https://reaya.app/r/
# App download link in staff invite SMS
APP_DOWNLOAD_URL=https://reaya.app/download
