# ── App ─────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=*

# ── Database ────────────────────────────────
# Must be a replica set (transactions). `docker compose up -d` starts a single-node one.
MONGO_URI=mongodb://127.0.0.1:27017/reayah?directConnection=true

# ── Redis (BullMQ, cache, idempotency) ──────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth ────────────────────────────────────
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# ── SMS / OTP ───────────────────────────────
# `log` prints OTP codes to the server log (dev only; refused when NODE_ENV=production).
SMS_DRIVER=log

# ── Field encryption (required) ─────────────
# base64 32-byte key. Generate one per environment and never change it without re-encrypting data:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# ── File storage (S3-compatible, private bucket) ──
# Values below match the MinIO container in docker-compose.yml. Leave S3_BUCKET empty to disable storage.
S3_BUCKET=reaya-private
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=reaya
S3_SECRET_ACCESS_KEY=reaya-dev-secret
S3_FORCE_PATH_STYLE=true

# ── Firebase (optional) ─────────────────────
# Absolute or project-relative path to the service-account JSON.
# Keep the file OUTSIDE the repo or inside ./secrets (gitignored).
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── Error tracking (optional) ───────────────
SENTRY_DSN=

# Per-IP request limits (Redis-backed)
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=30

# ── Bull Board ──────────────────────────────
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me

# Card / wallet payments (M2.3). `fake` works locally without keys (refused in production).
PAYMENT_GATEWAY=fake
PUBLIC_API_URL=http://localhost:3000
APP_PAYMENT_RETURN_URL=reaya://payment-result
# Paymob (Dashboard → Developers → API keys / Payment integrations). Sandbox keys until the merchant account is approved.
PAYMOB_API_URL=https://accept.paymob.com
PAYMOB_CHECKOUT_URL=https://eg.checkout.paymob.com/
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
